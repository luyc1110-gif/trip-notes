# 複製成 .env.local 後填入。本機開發可以全部留空：
# 沒有 DATABASE_URL 時會用專案內的 .pglite/ 資料夾當資料庫，
# 沒有 Google 設定時登入頁會出現「開發模式登入」按鈕（僅限非正式環境）。

# Neon 連線字串（正式環境必填）
DATABASE_URL=

# 簽署登入與邀請 cookie 用的密鑰（正式環境必填，至少 32 個隨機字元）
SESSION_SECRET=

# 允許登入建立旅程的 Google 帳號，逗號分隔
OWNER_EMAILS=

# Google OAuth 用戶端（Google Cloud Console → API 和服務 → 憑證）
# 已授權的重新導向 URI：https://你的網域/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps JavaScript API 金鑰（需啟用 Maps JavaScript API 與 Places API (New)）
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# 選填：Google Cloud 的地圖 ID；留空會用示範用的 DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_MAP_ID=

# 顯示名稱
NEXT_PUBLIC_APP_NAME=旅途手札
